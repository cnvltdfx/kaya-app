# Copy to .env (or set in your ECS task definition / Secrets Manager).
PORT=3000
NODE_ENV=development          # "production" hides dev MFA codes / reset links and enables static caching

# MySQL. Locally the defaults match docker-compose.yml (127.0.0.1:3306, kaya/kaya, database kaya).
# In AWS the EC2 user_data sets DB_HOST, DB_NAME and DB_SECRET_ARN; user and password then come
# from that Secrets Manager secret and the connection uses TLS.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kaya
DB_USER=kaya
DB_PASSWORD=kaya
DB_SECRET_ARN=
DB_POOL_SIZE=10

# Reports -> Amazon S3. Leave S3_BUCKET empty to write to ./reports instead.
S3_BUCKET=
AWS_REGION=ap-southeast-1
KMS_KEY_ID=                   # optional: SSE-KMS key for report encryption (defaults to SSE-S3)
REPORTS_PORT=                 # AWS only: private port the scheduled report Lambda calls; turns off the in-process 00:05 timer

# Observability SLO thresholds used for alerts
SLO_P95_MS=300
SLO_ERROR_RATE=0.02

# Chaos testing: fraction of recommendation requests that fail (proves non-critical features fail gracefully)
RECS_FAIL_RATE=0

# Frontend hosting. Comma-separated origins allowed to call the API cross-origin (e.g. the
# CloudFront/S3 site when it doesn't route /api/* through the same domain).
CORS_ORIGINS=
# Directory of the static storefront served for local dev (default ../frontend). Empty disables it.
# FRONTEND_DIR=
