# Copy to terraform.tfvars and adjust.
aws_region    = "ap-southeast-1"
instance_type = "t3.micro"

asg_min_size       = 2
asg_max_size       = 6
warm_pool_min_size = 2

# Switch to ForecastAndScale after reviewing a few days of forecasts.
predictive_scaling_mode = "ForecastOnly"

# Extra capacity for a sale (Asia/Singapore time).
scheduled_scaling_actions = {
  "1111-sale-start" = { start_time = "2026-11-10T22:00:00Z", min_size = 4, max_size = 10, desired_capacity = 4 }
  "1111-sale-end"   = { start_time = "2026-11-12T16:00:00Z", min_size = 2, max_size = 6, desired_capacity = 2 }
}

# acm_certificate_arn        = "arn:aws:acm:ap-southeast-1:123456789012:certificate/..."
# alb_origin_domain          = "origin.example.com"   # required with acm_certificate_arn (cdn.tf)
# restrict_alb_to_cloudfront = true                   # after the site works through CloudFront

# CloudFront WAF (waf.tf). Switch to block after reviewing a few days of counted matches.
# waf_mode            = "block"
# waf_rate_limit      = 2000
# waf_auth_rate_limit = 100

# Order processing
# ses_from_address  = "orders@example.com"
# staff_alert_email = "staff@example.com"

# Monitoring (monitoring.tf)
# Each address gets an "AWS Notification - Subscription Confirmation" email: click Confirm.
# alert_emails = ["staff1@example.com", "staff2@example.com"]

# Dashboard graph granularity in seconds (60 = one point per minute, 300 = per 5 minutes).
# dashboard_period_seconds = 60

# Alarm evaluation period in seconds (multiples of 60). Critical = site-down alarms (no healthy servers, NAT).
# alarm_period_seconds          = 300
# alarm_critical_period_seconds = 60

# Reporting: set after enabling QuickSight and generating the first report (README "Reports")
# quicksight_user_arn = "arn:aws:quicksight:ap-southeast-1:123456789012:user/default/your-name"

# Data archival (archive.tf). Defaults: 03:00 SGT on the 15th; closed orders older than 2 years;
# Glacier after 1 year; deleted after 5 years. For a quick demo, see demo.tfvars.example.
# archive_schedule           = "cron(0 3 15 * ? *)"
# archive_order_age_days     = 730
# archive_glacier_after_days = 365
# archive_expire_after_days  = 1825
